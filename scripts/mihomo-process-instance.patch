+package process
+
+import C "github.com/metacubex/mihomo/constant"
+
+type Instance struct {
+	PID     uint32
+	Started uint64
+	Path    string
+}
+
+var matchInstance func(*C.Metadata, Instance) bool
+
+func MatchInstance(metadata *C.Metadata, instance Instance) bool {
+	return matchInstance != nil && matchInstance(metadata, instance)
+}
diff --git a/component/process/instance_windows.go b/component/process/instance_windows.go
new file mode 100644
index 0000000..bfcbb3e
--- /dev/null
+++ b/component/process/instance_windows.go
@@ -0,0 +1,129 @@
+package process
+
+import (
+	"encoding/binary"
+	"net"
+	"net/netip"
+	"path/filepath"
+	"strings"
+
+	C "github.com/metacubex/mihomo/constant"
+	"golang.org/x/sys/windows"
+)
+
+func init() {
+	matchInstance = matchWindowsInstance
+}
+
+func matchWindowsInstance(metadata *C.Metadata, expected Instance) bool {
+	if metadata.Type == C.INNER || !metadata.SrcIP.IsValid() {
+		return false
+	}
+	tcp := metadata.NetWork == C.TCP
+	var remote netip.AddrPort
+	if tcp {
+		if metadata.Type == C.TUN {
+			addr, ok := metadata.RawDstAddr.(*net.TCPAddr)
+			if !ok {
+				return false
+			}
+			remote = addr.AddrPort()
+		} else {
+			remote = netip.AddrPortFrom(metadata.InIP, metadata.InPort)
+		}
+		if !remote.IsValid() || remote.Port() == 0 {
+			return false
+		}
+	} else if metadata.NetWork != C.UDP {
+		return false
+	}
+	once.Do(func() { _ = initWin32API() })
+	fn, class := getExUDPTable, udpTablePid
+	if tcp {
+		fn, class = getExTCPTable, tcpTablePidConn
+	}
+	if fn == 0 {
+		return false
+	}
+	source := metadata.SrcIP.Unmap().WithZone("")
+	var owner uint32
+	families := []int{windows.AF_INET6}
+	if source.Is4() {
+		families = append(families, windows.AF_INET)
+	}
+	for _, family := range families {
+		table, err := getTransportTable(fn, family, class)
+		if err != nil {
+			return false
+		}
+		layout := newSearcher(family == windows.AF_INET, tcp)
+		if !confirmOwner(table, layout, source, metadata.SrcPort, remote, expected.PID, &owner) {
+			return false
+		}
+	}
+	if owner != expected.PID {
+		return false
+	}
+	handle, err := windows.OpenProcess(windows.PROCESS_QUERY_LIMITED_INFORMATION|windows.SYNCHRONIZE, false, owner)
+	if err != nil {
+		return false
+	}
+	defer windows.CloseHandle(handle)
+	var start, exit, kernel, user windows.Filetime
+	if windows.GetProcessTimes(handle, &start, &exit, &kernel, &user) != nil ||
+		(uint64(start.HighDateTime)<<32|uint64(start.LowDateTime)) != expected.Started {
+		return false
+	}
+	path := make([]uint16, 32768)
+	size := uint32(len(path))
+	if windows.QueryFullProcessImageName(handle, 0, &path[0], &size) != nil ||
+		!strings.EqualFold(filepath.Clean(expected.Path), filepath.Clean(windows.UTF16ToString(path[:size]))) {
+		return false
+	}
+	state, err := windows.WaitForSingleObject(handle, 0)
+	return err == nil && state == uint32(windows.WAIT_TIMEOUT)
+}
+
+// A TCP owner must match both endpoints. For UDP the Windows table has only the
+// local endpoint, so a shared endpoint with another owner cannot identify an instance.
+func confirmOwner(table []byte, layout *searcher, source netip.Addr, port uint16, remote netip.AddrPort, expected uint32, owner *uint32) bool {
+	if len(table) < 4 {
+		return false
+	}
+	count := int(binary.LittleEndian.Uint32(table))
+	if count > (len(table)-4)/layout.itemSize {
+		return false
+	}
+	for i := 0; i < count; i++ {
+		at := 4 + i*layout.itemSize
+		row := table[at : at+layout.itemSize]
+		local, _ := netip.AddrFromSlice(row[layout.ip : layout.ip+layout.ipSize])
+		local = local.Unmap()
+		if binary.BigEndian.Uint16(row[layout.port:]) != port ||
+			(local != source && (remote.IsValid() || !local.IsUnspecified())) {
+			continue
+		}
+		if remote.IsValid() {
+			if binary.LittleEndian.Uint32(row[layout.tcpState:]) != 5 {
+				continue
+			}
+			// MIB_TCPROW_OWNER_PID and MIB_TCP6ROW_OWNER_PID both put the
+			// remote address just after the four-byte local port field.
+			start := layout.port + 4
+			peerIP, _ := netip.AddrFromSlice(row[start : start+layout.ipSize])
+			peerPort := layout.pid - 4
+			if layout.ipSize == 16 {
+				peerPort = layout.tcpState - 4
+			}
+			if peerIP.Unmap() != remote.Addr().Unmap().WithZone("") || binary.BigEndian.Uint16(row[peerPort:]) != remote.Port() {
+				continue
+			}
+		}
+		pid := binary.LittleEndian.Uint32(row[layout.pid:])
+		if pid != expected {
+			return false
+		}
+		*owner = pid
+	}
+	return true
+}
