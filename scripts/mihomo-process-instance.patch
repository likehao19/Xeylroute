diff --git a/rules/common/process_instance.go b/rules/common/process_instance.go
new file mode 100644
index 0000000..9b6320b
--- /dev/null
+++ b/rules/common/process_instance.go
@@ -0,0 +1,43 @@
+package common
+
+import (
+	"encoding/base64"
+	"fmt"
+	"strconv"
+	"strings"
+
+	"github.com/metacubex/mihomo/component/process"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type ProcessInstance struct {
+	Base
+	payload  string
+	adapter  string
+	identity process.Instance
+}
+
+func (r *ProcessInstance) RuleType() C.RuleType { return C.ProcessInstance }
+func (r *ProcessInstance) Payload() string      { return r.payload }
+func (r *ProcessInstance) Adapter() string      { return r.adapter }
+
+func (r *ProcessInstance) Match(metadata *C.Metadata, _ C.RuleMatchHelper) (bool, string) {
+	return process.MatchInstance(metadata, r.identity), r.adapter
+}
+
+func NewProcessInstance(payload, adapter string) (*ProcessInstance, error) {
+	fields := strings.SplitN(payload, ":", 3)
+	if len(fields) != 3 {
+		return nil, fmt.Errorf("invalid PROCESS-INSTANCE identity")
+	}
+	pid, pidErr := strconv.ParseUint(fields[0], 10, 32)
+	started, startErr := strconv.ParseUint(fields[1], 10, 64)
+	path, pathErr := base64.RawURLEncoding.DecodeString(fields[2])
+	if pidErr != nil || startErr != nil || pathErr != nil || pid == 0 || started == 0 || len(path) == 0 {
+		return nil, fmt.Errorf("invalid PROCESS-INSTANCE identity")
+	}
+	return &ProcessInstance{
+		payload: payload, adapter: adapter,
+		identity: process.Instance{PID: uint32(pid), Started: started, Path: string(path)},
+	}, nil
+}
