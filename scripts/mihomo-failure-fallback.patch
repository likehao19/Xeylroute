diff --git a/tunnel/routepilot_fallback.go b/tunnel/routepilot_fallback.go
new file mode 100644
index 0000000..d37bf78
--- /dev/null
+++ b/tunnel/routepilot_fallback.go
@@ -0,0 +1,80 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/log"
+	"golang.org/x/sync/singleflight"
+)
+
+var routePilotProbe atomic.Pointer[string]
+var routePilotProbes singleflight.Group
+var routePilotExpectedStatus, _ = utils.NewUnsignedRanges[uint16]("204")
+
+func SetRoutePilotFallbackProbe(url string) {
+	routePilotProbe.Store(&url)
+}
+
+func routePilotProbeHealthy(proxy C.Proxy, url string) bool {
+	result, _, _ := routePilotProbes.Do(fmt.Sprintf("%p:%s", proxy, url), func() (any, error) {
+		state := proxy.ExtraDelayHistories()[url]
+		if n := len(state.History); n > 0 && time.Since(state.History[n-1].Time) < 5*time.Second {
+			return state.Alive, nil
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer cancel()
+		_, err := proxy.URLTest(ctx, url, routePilotExpectedStatus)
+		return err == nil && proxy.AliveForTestUrl(url), nil
+	})
+	return result.(bool)
+}
+
+func routePilotSelectedNode(proxy C.Proxy, metadata *C.Metadata) C.Proxy {
+	// Load-balancing groups can choose a different node on every dial.
+	for i := 0; i < 20; i++ {
+		if proxy.Type() == C.LoadBalance {
+			return nil
+		}
+		next := proxy.Unwrap(metadata, false)
+		if next == nil {
+			if proxy.Type() >= C.Shadowsocks && proxy.Addr() != "" {
+				return proxy
+			}
+			return nil
+		}
+		proxy = next
+	}
+	return nil
+}
+
+func routePilotFallback[T any](metadata *C.Metadata, proxy C.Proxy, dialError error, dial func(context.Context, C.Proxy) (T, error)) (result T, err error) {
+	check := routePilotProbe.Load()
+	if check == nil || *check == "" || metadata.SpecialProxy != "" || shouldStopRetry(dialError) ||
+		errors.Is(dialError, context.Canceled) || errors.Is(dialError, C.ErrNotSupport) {
+		return result, dialError
+	}
+	leaf := routePilotSelectedNode(proxy, metadata)
+	if leaf == nil {
+		return result, dialError
+	}
+	configMux.RLock()
+	direct := proxies["DIRECT"]
+	configMux.RUnlock()
+	if direct == nil || routePilotProbeHealthy(leaf, *check) || !routePilotProbeHealthy(direct, *check) ||
+		routePilotProbe.Load() != check || routePilotSelectedNode(proxy, metadata) != leaf {
+		return result, dialError
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), C.DefaultTCPTimeout)
+	defer cancel()
+	result, err = dial(ctx, direct)
+	if err == nil {
+		log.Warnln("[RoutePilot] %s unavailable; using DIRECT for this connection", leaf.Name())
+	}
+	return result, err
+}
